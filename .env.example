# Desktop default. For phone testing, use the computer's LAN address,
# for example http://192.168.1.13:1337, and run npm run dev:lan.
NUXT_PUBLIC_API_URL=http://localhost:1337

# Public, non-secret prototype indicator. Keep true until PAMANA has verified
# operational transport inputs for the passenger-facing trip planner.
NUXT_PUBLIC_DEMO_MODE=true

# Display opt-in for the Phase 16 simulated live feed. The backend gate is
# independent and authoritative; keep this false in normal passenger builds.
NUXT_PUBLIC_PAMANA_DEMO_MODE_ENABLED=false

# Legacy setting retained in runtime configuration; unused by the active map stack.
NUXT_PUBLIC_CARTO_BASEMAP_KEY=

# Geoapify browser configuration for MapLibre basemaps and geographic search.
# Missing configuration shows a readable map-unavailable state.
# Restrict this public key to approved origins/referrers in Geoapify MyProjects.
NUXT_PUBLIC_GEOAPIFY_API_KEY=
# Style identifier only; blank uses osm-carto when a key is configured.
NUXT_PUBLIC_GEOAPIFY_MAP_STYLE=
