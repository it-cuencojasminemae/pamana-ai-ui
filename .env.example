NUXT_PUBLIC_API_URL=http://localhost:1337

# Public, non-secret prototype indicator. Keep true until PAMANA has verified
# operational transport inputs for the passenger-facing trip planner.
NUXT_PUBLIC_DEMO_MODE=true

# Optional public CARTO Voyager browser tile key. When absent, the passenger
# map falls back to OpenStreetMap tiles.
NUXT_PUBLIC_CARTO_BASEMAP_KEY=
